    "dataDefinition.dataSourceId = data_sources.id",
    "waterBalance.assetId = assets.id",
    "waterBalance.systemInputId = dataDefinition.id",
    "waterBalance.billMeteredId = dataDefinition.id",
    "waterBalance.billUnmeteredId = dataDefinition.id",
    "assetProperties.assetId = assets.id",
    "assets.i2 = consumer_profile.profileId"
