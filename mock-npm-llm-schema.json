{
  "schema_name": "mock_npm_llm",
  "version": "1.0.0",
  "purpose": "Mock water-utility monitoring schema inspired by NPM backend models. Intended for LLM SQL generation and DB interaction tests.",
  "source_models": [
    "src/database/models/assets.js",
    "src/database/models/assetsproperties.js",
    "src/database/models/datadefinition.js",
    "src/database/models/sdata.js",
    "src/database/models/sdatacurrent.js",
    "src/database/models/measurementtype.js",
    "src/database/models/measurementpointtype.js",
    "src/database/models/facilitytype.js",
    "src/database/models/operationarea.js",
    "src/database/models/region.js",
    "src/database/models/district.js",
    "src/database/models/districtinfo.js",
    "src/database/models/datasources.js",
    "src/database/models/waterbalance.js",
    "src/database/models/consumerprofile.js"
  ],
  "notes": [
    "This is a simplified schema for testing, not a production mirror.",
    "Column names intentionally preserve the NPM style where useful, including generic fields like s1, f1, and i1.",
    "Time-series values are split into an archive table (s_data) and a latest-value table (s_data_current).",
    "Most operational queries should join assets, dataDefinition, measurementType, districtInfo, and one of the s_data tables."
  ],
