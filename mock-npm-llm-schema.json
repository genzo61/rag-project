    "dataDefinition.measurementTypeId = measurementType.id",
    "assets.measurementPointTypeId = measurementPointType.id",
    "assets.facilityTypeId = facilityType.id",
    "assets.opAreaId = operationArea.opAreaId",
    "assets.region = region.id",
    "assets.district = districtInfo.id",
