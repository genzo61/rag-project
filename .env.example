DB_HOST=localhost
DB_PORT=5436
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=replace_with_db_password

DP_DB_HOST=localhost
DP_DB_PORT=5433
DP_DB_NAME=demo_local
DP_DB_USER=demo_user
DP_DB_PASSWORD=replace_with_dp_db_password

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma-4-e2b-it:latest
OLLAMA_FALLBACK_MODELS=llama3.2:3b
OLLAMA_API_KEY=ollama
LOCAL_CHAT_MODEL_ID=gemma4local:latest
LOCAL_CHAT_MODEL_PATH=replace_with_local_model_manifest_path
RAG_UI_API_BASE_URL=http://127.0.0.1:8000
RAG_UI_MODEL_ID=gemma4local:latest
SEARXNG_BASE_URL=http://localhost:8089
CHAT_STORE_PATH=data/chat_history.sqlite3
DEBUG_TRACE_LIMIT=100
DP_ASSISTANT_SEED_ON_STARTUP=true
DP_ASSISTANT_SEED_ASYNC=true
 
